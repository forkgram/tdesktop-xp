diff --git a/tgcalls/desktop_capturer/DesktopCapture_dummy.cpp b/tgcalls/desktop_capturer/DesktopCapture_dummy.cpp
new file mode 100644
index 0000000..e52b4a1
--- /dev/null
+++ b/tgcalls/desktop_capturer/DesktopCapture_dummy.cpp
@@ -0,0 +1,120 @@
+// XP walk: the tgcalls desktop-capturer (DesktopCaptureSource / Helper /
+// Manager) is WebRTC-backed and excluded under
+// DESKTOP_APP_DISABLE_WEBRTC_INTEGRATION, yet
+// calls/group/ui/desktop_capture_choose_source.cpp + calls_group_panel.cpp
+// reference its symbols. Provide no-op stubs so the app links (screen sharing
+// is non-functional on the XP build). Minimal stand-ins for the forward-declared
+// WebRTC member types make the smart-pointer destructors well-formed.
+
+#include "tgcalls/desktop_capturer/DesktopCaptureSource.h"
+#include "tgcalls/desktop_capturer/DesktopCaptureSourceHelper.h"
+#include "tgcalls/desktop_capturer/DesktopCaptureSourceManager.h"
+
+namespace webrtc {
+// Complete stand-ins so unique_ptr<webrtc::DesktopCapturer> in the manager and
+// the VideoFrame/sink template args resolve without the real WebRTC headers.
+class DesktopCapturer {};
+class DesktopCaptureOptions {};
+} // namespace webrtc
+
+namespace tgcalls {
+
+std::string DesktopCaptureSourceData::cachedKey() const {
+	return std::string();
+}
+
+DesktopCaptureSource::DesktopCaptureSource(
+	long long uniqueId,
+	std::string title,
+	bool isWindow)
+: _uniqueId(uniqueId)
+, _title(std::move(title))
+, _isWindow(isWindow) {
+}
+
+long long DesktopCaptureSource::uniqueId() const {
+	return _uniqueId;
+}
+
+bool DesktopCaptureSource::isWindow() const {
+	return _isWindow;
+}
+
+std::string DesktopCaptureSource::deviceIdKey() const {
+	return std::string();
+}
+
+std::string DesktopCaptureSource::title() const {
+	return _title;
+}
+
+std::string DesktopCaptureSource::uniqueKey() const {
+	return std::string();
+}
+
+std::string DesktopCaptureSource::deviceIdKey() {
+	return std::string();
+}
+
+std::string DesktopCaptureSource::title() {
+	return _title;
+}
+
+std::string DesktopCaptureSource::uniqueKey() {
+	return std::string();
+}
+
+DesktopCaptureSource DesktopCaptureSourceForKey(const std::string &uniqueKey) {
+	return DesktopCaptureSource::Invalid();
+}
+
+bool ShouldBeDesktopCapture(const std::string &uniqueKey) {
+	return false;
+}
+
+struct DesktopCaptureSourceHelper::Renderer {
+};
+
+DesktopCaptureSourceHelper::DesktopCaptureSourceHelper(
+	DesktopCaptureSource source,
+	DesktopCaptureSourceData data) {
+}
+
+DesktopCaptureSourceHelper::~DesktopCaptureSourceHelper() = default;
+
+void DesktopCaptureSourceHelper::setOutput(
+	std::shared_ptr<
+		rtc::VideoSinkInterface<webrtc::VideoFrame>> sink) const {
+}
+
+void DesktopCaptureSourceHelper::setSecondaryOutput(
+	std::shared_ptr<
+		rtc::VideoSinkInterface<webrtc::VideoFrame>> sink) const {
+}
+
+void DesktopCaptureSourceHelper::start() const {
+}
+
+void DesktopCaptureSourceHelper::stop() const {
+}
+
+void DesktopCaptureSourceHelper::setOnFatalError(
+	std::function<void()> error) const {
+}
+
+void DesktopCaptureSourceHelper::setOnPause(
+	std::function<void(bool)> pause) const {
+}
+
+DesktopCaptureSourceManager::DesktopCaptureSourceManager(
+	DesktopCaptureType type)
+: _type(type) {
+}
+
+DesktopCaptureSourceManager::~DesktopCaptureSourceManager() = default;
+
+std::vector<DesktopCaptureSource> DesktopCaptureSourceManager::sources() {
+	return {};
+}
+
+} // namespace tgcalls
