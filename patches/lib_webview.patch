+// XP walk: the real Windows backend uses the WebView2 SDK (a Win10+ NuGet
+// package) and the EdgeHTML WinRT stack (/await coroutines), neither of which is
+// available to the v141_xp toolchain or to Windows XP at runtime. Build a stub
+// factory instead: webview is reported as unavailable and never instantiated, so
+// the in-app features that embed a browser (bot web-apps, payments, passport)
+// degrade gracefully to "not supported" on the XP build.
 
 namespace Webview {
 
 Available Availability() {
-	if (EdgeHtml::Supported() || EdgeChromium::Supported()) {
-		return Available{};
-	}
 	return Available{
-		.error = Available::Error::NoWebview2,
-		.details = "Please install Microsoft Edge Webview2 Runtime.",
+		Available::Error::NoWebview2,
+		"WebView2 is not available on this system.",
 	};
-	// WebKit2Gtk::Supported();
 }
 
 bool SupportsEmbedAfterCreate() {
-	return EdgeHtml::Supported();
+	return false;
 }
 
 std::unique_ptr<Interface> CreateInstance(Config config) {
-	if (auto result = EdgeHtml::CreateInstance(config)) {
-		return result;
-	}
-	return EdgeChromium::CreateInstance(std::move(config));
+	return nullptr;
 }
 
 } // namespace Webview
