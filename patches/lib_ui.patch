@@ -16,6 +16,19 @@
 
 #include <windowsx.h>
 
+// WM_NCPOINTER* are Win8 non-client pointer-input messages, absent from the XP
+// SDK headers. They are only matched in a switch and never arrive on XP; define
+// the constants so the switch compiles.
+#ifndef WM_NCPOINTERUPDATE
+#define WM_NCPOINTERUPDATE 0x0241
+#endif
+#ifndef WM_NCPOINTERDOWN
+#define WM_NCPOINTERDOWN 0x0242
+#endif
+#ifndef WM_NCPOINTERUP
+#define WM_NCPOINTERUP 0x0243
+#endif
