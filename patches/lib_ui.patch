 }
 
 } // namespace style
+
+// <windows.h> (via Qt, no WIN32_LEAN_AND_MEAN) drags in rpcndr.h's
+// `#define small char` / `#define hyper __int64`. Generated style structs have
+// members named `small`; generated style headers include this one right before
+// those structs, so undefining here keeps the identifiers usable.
+#ifdef small
+#undef small
+#endif
+#ifdef hyper
+#undef hyper
+#endif
