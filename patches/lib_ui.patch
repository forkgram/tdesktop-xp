 namespace {
 
 bool IsCompositionEnabled() {
+	// XP walk: DwmIsCompositionEnabled is a Vista+ DWM API in dwmapi.dll, which is
+	// delay-loaded and absent on Windows XP. Calling it directly trips the delay-load
+	// failure handler and terminates the app at startup on XP, so resolve it
+	// dynamically and report "no composition" when the DLL/symbol is unavailable.
+	static const auto resolved = [] {
+		const auto library = LoadLibrary(L"dwmapi.dll");
+		return library
+			? reinterpret_cast<decltype(&DwmIsCompositionEnabled)>(
+				GetProcAddress(library, "DwmIsCompositionEnabled"))
+			: nullptr;
+	}();
 	auto result = BOOL(FALSE);
-	const auto success = (DwmIsCompositionEnabled(&result) == S_OK);
-	return success && result;
+	return resolved && (resolved(&result) == S_OK) && result;
 }
 
