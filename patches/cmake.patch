diff --git a/external/jpeg/CMakeLists.txt b/external/jpeg/CMakeLists.txt
index cfa4c26..2098b25 100644
--- a/external/jpeg/CMakeLists.txt
+++ b/external/jpeg/CMakeLists.txt
@@ -13,23 +13,23 @@ if (DESKTOP_APP_USE_PACKAGED)
     return()
 endif()
 
-add_library(external_jpeg STATIC IMPORTED GLOBAL)
+# XP walk: v3.6.3 restructured this to create external_jpeg itself (STATIC IMPORTED
+# pointing at libs_loc/mozjpeg), but there is no external mozjpeg in Libraries-walk.
+# Our static Qt 5.15-XP bundles libjpeg (qtlibjpeg) and already links it through
+# common_qt_libs, and no source links jpeg directly, so create an INTERFACE target
+# that just exposes the bundled headers (hard-coded like qt_loc in qt/package.cmake)
+# to satisfy external_qt's include validation -- no IMPORTED_LOCATION lib, which
+# avoids double-linking qtlibjpeg.
+add_library(external_jpeg INTERFACE IMPORTED GLOBAL)
 add_library(desktop-app::external_jpeg ALIAS external_jpeg)
 
 if (WIN32)
-    set(jpeg_lib_loc ${libs_loc}/mozjpeg)
-    target_include_directories(external_jpeg SYSTEM INTERFACE ${jpeg_lib_loc})
-    set_target_properties(external_jpeg PROPERTIES
-        IMPORTED_LOCATION "${jpeg_lib_loc}/Release/jpeg-static.lib"
-        IMPORTED_LOCATION_DEBUG "${jpeg_lib_loc}/Debug/jpeg-static.lib"
-    )
+    target_include_directories(external_jpeg INTERFACE
+        C:/TBuild/xp-port/qt-xp-static-prefix/include/qtlibjpeg)
+elseif (APPLE AND NOT build_osx)
+    target_link_libraries(external_jpeg INTERFACE /usr/local/macos/lib/libjpeg.a)
 elseif (APPLE)
-    set_target_properties(external_jpeg PROPERTIES
-        IMPORTED_LOCATION ${libs_loc}/local/lib/libjpeg.a
-    )
+    target_link_libraries(external_jpeg INTERFACE ${libs_loc}/local/lib/libjpeg.a)
 else()
-    find_library(DESKTOP_APP_JPEG_LIBRARIES libjpeg.a REQUIRED)
-    set_target_properties(external_jpeg PROPERTIES
-        IMPORTED_LOCATION "${DESKTOP_APP_JPEG_LIBRARIES}"
-    )
+    target_link_libraries(external_jpeg INTERFACE jpeg)
 endif()
