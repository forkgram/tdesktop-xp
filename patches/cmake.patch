diff --git a/init_target.cmake b/init_target.cmake
index 21570d9..d7d17f9 100644
--- a/init_target.cmake
+++ b/init_target.cmake
@@ -4,7 +4,12 @@
 # For license and copyright information please follow this link:
 # https://github.com/desktop-app/legal/blob/master/LEGAL
 
-set(MAXIMUM_CXX_STANDARD cxx_std_20)
+# XP walk: cap at C++17 -- C++20 defines __cpp_concepts, which sends our range-v3
+# down its native-concepts path that the v141_xp 14.16 target rejects (C7593/C7602).
+set(MAXIMUM_CXX_STANDARD cxx_std_17)
+if (CMAKE_CXX_COMPILER_ID STREQUAL "GNU" OR CMAKE_CXX_COMPILER_ID MATCHES "Clang")
+    set(MAXIMUM_CXX_STANDARD cxx_std_17)
+endif()
 
 function(init_target_folder target_name folder_name)
     if (NOT "${folder_name}" STREQUAL "")
@@ -27,7 +32,14 @@ function(init_target target_name) # init_target(my_target folder_name)
         set_target_properties(${target_name} PROPERTIES
             MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
     endif()
-    target_link_libraries(${target_name} PRIVATE desktop-app::common_options)
+    target_link_libraries(${target_name} PUBLIC desktop-app::common_options)
+    # XP walk: v2.5.9 made WebRTC mandatory and dropped the propagation of this
+    # option into a C++ compile definition (the `#ifdef DESKTOP_APP_DISABLE_WEBRTC_
+    # INTEGRATION` guards in calls_instance/calls_call rely on it). Re-add it for
+    # every target so the WebRTC-disabled code paths compile on XP.
+    if (DESKTOP_APP_DISABLE_WEBRTC_INTEGRATION)
+        target_compile_definitions(${target_name} PUBLIC DESKTOP_APP_DISABLE_WEBRTC_INTEGRATION)
+    endif()
     if (NOT DESKTOP_APP_USE_PACKAGED)
         set_target_properties(${target_name} PROPERTIES LINK_SEARCH_START_STATIC 1)
     endif()
