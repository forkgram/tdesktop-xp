+# XP walk: the TooManyCooks (tmc) coroutine backend is C++20-only and is NEVER
+# selected on our build -- crl_common_config.h picks CRL_USE_WINAPI on MSVC/x86,
+# so crl/tmc/crl_tmc_async.h is never included and no tmc header is compiled.
+# The submodule is intentionally NOT provisioned. CMake validates the existence
+# of INTERFACE_INCLUDE_DIRECTORIES at generate time, so only add the include dir
+# when the submodule happens to be present -- otherwise external_tmc stays a pure
+# (harmless) INTERFACE target that lib_crl links but never pulls headers from.
+if (EXISTS ${third_party_loc}/TooManyCooks/include)
+    target_include_directories(external_tmc SYSTEM
+    INTERFACE
+        ${third_party_loc}/TooManyCooks/include
+    )
+endif()
