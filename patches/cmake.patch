diff --git a/external/CMakeLists.txt b/external/CMakeLists.txt
index ce7e67d..3da8021 100644
--- a/external/CMakeLists.txt
+++ b/external/CMakeLists.txt
@@ -11,6 +11,15 @@ macro(add_checked_subdirectory name)
     endif()
 endmacro()
 
+# XP walk: Windows has no X11/Wayland/DBus. Set these as CMAKE VARIABLES (not
+# just compile-defs) so configure-time guards (e.g. kcoreaddons qt_add_dbus_
+# interface, a Qt6-only cmd) are skipped on the Qt5.15-XP build.
+if (WIN32)
+    set(DESKTOP_APP_DISABLE_X11_INTEGRATION TRUE)
+    set(DESKTOP_APP_DISABLE_WAYLAND_INTEGRATION TRUE)
+    set(DESKTOP_APP_DISABLE_DBUS_INTEGRATION TRUE)
+endif()
+
