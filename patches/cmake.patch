--- a/options_win.cmake
+++ b/options_win.cmake
@@ -12,15 +12,33 @@ INTERFACE
     NOMINMAX
     UNICODE
     _UNICODE
+    # XP walk: target Windows XP (0x0501) and disable breakpad crash reports
+    # (new + old guard names). Propagates to every target via common_options.
+    _WIN32_WINNT=0x0501
+    WINVER=0x0501
+    NTDDI_VERSION=0x05010300
+    TDESKTOP_DISABLE_CRASH_REPORTS
+    DESKTOP_APP_DISABLE_CRASH_REPORTS
+    # XP walk: Windows build has no X11/Wayland; v4.2.x lib_ui guards new linux
+    # xcb includes behind these. Define them so the linux headers are skipped.
+    DESKTOP_APP_DISABLE_X11_INTEGRATION
+    DESKTOP_APP_DISABLE_WAYLAND_INTEGRATION
+    DESKTOP_APP_DISABLE_DBUS_INTEGRATION
 )
 if (CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
     target_compile_options(common_options
     INTERFACE
-        /permissive-
+        # XP walk: drop /permissive- and /WX (the v141_xp 14.16 target + our compat
+        # patches emit warnings the stock build does not); /d2FH4- makes the 14.44
+        # binary emit the __CxxFrameHandler3 EH personality the XP CRT ships;
+        # force-include the XP compat shim; /Zc:preprocessor + /bigobj as in gyp.
+        /d2FH4-
+        /FIC:/TBuild/xp-port/xp-compat.h
+        /Zc:preprocessor
+        /bigobj
         # /Qspectre
         /utf-8
         /W1
-        /WX
         /MP     # Enable multi process build.
         /EHsc   # Catch C++ exceptions only, extern C functions never throw a C++ exception.
         /w14834 # [[nodiscard]]
@@ -37,6 +55,10 @@ if (CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
     target_link_options(common_options
     INTERFACE
         $<IF:$<CONFIG:Debug>,/NODEFAULTLIB:LIBCMT,/DEBUG;/OPT:REF>
+        # XP walk: tolerate fpcompat vs CRT duplicate FP/64-bit helpers (first wins).
+        # NOTE: /SUBSYSTEM:WINDOWS,5.01 is set on the Telegram exe target only, not
+        # here -- forcing it globally would break the console codegen_* host tools.
+        /FORCE:MULTIPLE
         $<$<BOOL:${DESKTOP_APP_NO_PDB}>:/DEBUG:NONE>
     )
 
@@ -95,6 +117,12 @@ endif()
 
 target_link_libraries(common_options
 INTERFACE
+    # XP walk: the 14.44 binary emits FP/64-bit CRT helpers (ftol2/ftol3/
+    # __dtoul3_legacy) the 14.16 XP CRT lacks. fpcompat.lib supplies them and must
+    # reach EVERY target -- not only the Telegram exe -- because the console
+    # codegen_* host tools link lib_base, whose unixtime.cpp (mtproto_msg_id) needs
+    # __dtoul3_legacy. /FORCE:MULTIPLE tolerates the overlap with the exe's copy.
+    C:/TBuild/xp-port/fpcompat/fpcompat.lib
     winmm
     imm32
     ws2_32
diff --git a/variables.cmake b/variables.cmake
