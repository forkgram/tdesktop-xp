 add_checked_subdirectory(angle)
 add_checked_subdirectory(auto_updates)
diff --git a/external/cmark_gfm/CMakeLists.txt b/external/cmark_gfm/CMakeLists.txt
index aa680fe..64c91f5 100644
--- a/external/cmark_gfm/CMakeLists.txt
+++ b/external/cmark_gfm/CMakeLists.txt
@@ -47,6 +47,13 @@ block()
     # __imp__ thunks that fail to link against tdesktop's static-CRT code.
     set(CMAKE_POLICY_DEFAULT_CMP0091 NEW)
 
+    # XP walk: our fork sets the static CRT PER-TARGET (options_win.cmake),
+    # NOT via a global CMAKE_MSVC_RUNTIME_LIBRARY, so cmark-gfm's CMP0091
+    # path found no global and defaulted to /MD -> pulled MSVCRT.lib ->
+    # __except_handler4_common (14.20+ CRT) unresolved against our 14.16
+    # static CRT (LNK2019). Set it static here, scoped to this block().
+    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
+
     # Normal-variable overrides for cmark-gfm's options(). With CMP0077
     # NEW (lifted above) these beat the hardcoded option() defaults
     # without any CACHE writes. BUILD_TESTING is intentionally NOT set:
