@@ -239,8 +239,11 @@ void object_async_data<Policy, Type>::construct(Args &&...args) {
 		&object_async_storage<Type>::value(),
 		std::forward<Args>(args)...
 	)]() mutable {
-		const auto create = [](void *storage, Args &&...args) {
-			new (storage) Type(std::forward<Args>(args)...);
+		// XP walk: MSVC 14.16 std::apply over a decayed make_tuple can't bind
