+// This file is part of Desktop App Toolkit,
+// a set of libraries for developing nice desktop applications.
+//
+// For license and copyright information please follow this link:
+// https://github.com/desktop-app/legal/blob/master/LEGAL
+//
+// XP walk: WebRTC-disabled (v141_xp) replacement for webrtc_environment_win.cpp.
+// The real Windows backend enumerates audio endpoints through WASAPI
+// (IMMDeviceEnumerator) and tracks device changes with a C++/WinRT
+// IMMNotificationClient -- neither is available on the Windows XP toolchain (no
+// mmdeviceapi WASAPI, no cppwinrt). Webrtc::Environment (kept) still constructs a
+// platform backend via Platform::CreateEnvironment(), so provide a minimal stub
+// that reports no devices and never fires device-change notifications.
+#include "webrtc/platform/webrtc_platform_environment.h"
+
+#include <memory>
+
+namespace Webrtc::Platform {
+namespace {
+
+class EnvironmentDummyWin final : public Environment {
+public:
+	explicit EnvironmentDummyWin(not_null<EnvironmentDelegate*> delegate);
+
+	QString defaultId(DeviceType type) override;
+	DeviceInfo device(DeviceType type, const QString &id) override;
+
+	std::vector<DeviceInfo> devices(DeviceType type) override;
+	bool refreshFullListOnChange(DeviceType type) override;
+
+	bool desktopCaptureAllowed() const override;
+	std::optional<QString> uniqueDesktopCaptureSource() const override;
+
+	// XP walk: v4.14.12 added these two pure-virtuals to Platform::Environment
+	// (lazy "validate/refresh" hooks). No-op here: this stub never enumerates.
+	void defaultIdRequested(DeviceType type) override;
+	void devicesRequested(DeviceType type) override;
+
+private:
+	const not_null<EnvironmentDelegate*> _delegate;
+
+};
+
+EnvironmentDummyWin::EnvironmentDummyWin(
+	not_null<EnvironmentDelegate*> delegate)
+: _delegate(delegate) {
+}
+
+QString EnvironmentDummyWin::defaultId(DeviceType type) {
+	return QString();
+}
+
+DeviceInfo EnvironmentDummyWin::device(DeviceType type, const QString &id) {
+	return DeviceInfo();
+}
+
+std::vector<DeviceInfo> EnvironmentDummyWin::devices(DeviceType type) {
+	return {};
+}
+
+bool EnvironmentDummyWin::refreshFullListOnChange(DeviceType type) {
+	return false;
+}
+
+bool EnvironmentDummyWin::desktopCaptureAllowed() const {
+	return false;
+}
+
+std::optional<QString> EnvironmentDummyWin::uniqueDesktopCaptureSource() const {
+	return std::nullopt;
+}
+
+void EnvironmentDummyWin::defaultIdRequested(DeviceType type) {
+}
+
+void EnvironmentDummyWin::devicesRequested(DeviceType type) {
+}
+
+} // namespace
+
+std::unique_ptr<Environment> CreateEnvironment(
+		not_null<EnvironmentDelegate*> delegate) {
+	return std::make_unique<EnvironmentDummyWin>(delegate);
+}
+
+} // namespace Webrtc::Platform
+
+// XP walk: v6.6.3 added Webrtc::LoopbackAudioCaptureSupported() (system-audio-
+// capture), called by calls_panel/calls_group_panel. Its real definition is in
+// webrtc_create_adm.cpp, which the DISABLE_WEBRTC build removes -> stub it (no
+// WASAPI loopback capture on the v141_xp toolchain).
+namespace Webrtc {
+bool LoopbackAudioCaptureSupported() {
+	return false;
+}
+} // namespace Webrtc
