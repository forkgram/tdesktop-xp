diff --git a/webrtc/webrtc_audio_input_tester_dummy.cpp b/webrtc/webrtc_audio_input_tester_dummy.cpp
new file mode 100644
index 0000000..b5d8267
--- /dev/null
+++ b/webrtc/webrtc_audio_input_tester_dummy.cpp
@@ -0,0 +1,48 @@
+// This file is part of Desktop App Toolkit,
+// a set of libraries for developing nice desktop applications.
+//
+// For license and copyright information please follow this link:
+// https://github.com/desktop-app/legal/blob/master/LEGAL
+//
+// XP walk: built instead of webrtc_audio_input_tester.cpp when
+// DESKTOP_APP_DISABLE_WEBRTC_INTEGRATION is set -- the real Impl derives from
+// webrtc::AudioTransport (full WebRTC, absent on v141_xp). This no-op tester keeps
+// the same public surface so callers link; the input-level meter just stays at 0.
+#include "webrtc/webrtc_audio_input_tester.h"
+
+#include "crl/crl_object_on_thread.h"
+
+namespace Webrtc {
+
+class AudioInputTester::Impl {
+public:
+	Impl(
+		const QString &deviceId,
+		const std::shared_ptr<std::atomic<int>> &maxSample) {
+	}
+
+	void setDeviceId(const QString &deviceId) {
+	}
+
+};
+
+AudioInputTester::AudioInputTester(
+	const Backend &backend,
+	const QString &deviceId)
+: _maxSample(std::make_shared<std::atomic<int>>(0))
+, _impl(deviceId, std::as_const(_maxSample)) {
+}
+
+AudioInputTester::~AudioInputTester() = default;
+
+void AudioInputTester::setDeviceId(const QString &deviceId) {
+	_impl.with([=](Impl &impl) {
+		impl.setDeviceId(deviceId);
+	});
+}
+
+float AudioInputTester::getAndResetLevel() {
+	return _maxSample->exchange(0) / float(INT16_MAX);
+}
+
+} // namespace Webrtc
diff --git a/webrtc/webrtc_media_devices_dummy.cpp b/webrtc/webrtc_media_devices_dummy.cpp
new file mode 100644
index 0000000..a6af457
--- /dev/null
+++ b/webrtc/webrtc_media_devices_dummy.cpp
@@ -0,0 +1,81 @@
+// This file is part of Desktop App Toolkit,
+// a set of libraries for developing nice desktop applications.
+//
+// For license and copyright information please follow this link:
+// https://github.com/desktop-app/legal/blob/master/LEGAL
+//
+// XP walk: built instead of webrtc_media_devices.cpp when
+// DESKTOP_APP_DISABLE_WEBRTC_INTEGRATION is set -- the real one pulls full WebRTC
+// headers (api/task_queue, modules/audio_device) absent from the v141_xp build.
+// Device enumeration is unavailable without WebRTC, so return empty lists; the
+// MediaDevices object just echoes back the ids it was created/switched with.
+#include "webrtc/webrtc_media_devices.h"
+
+#include <rpl/variable.h>
+#include <memory>
+
+namespace Webrtc {
+namespace {
+
+class MediaDevicesDummy final : public MediaDevices {
+public:
+	MediaDevicesDummy(
+		QString audioInput,
+		QString audioOutput,
+		QString videoInput)
+	: _audioInputId(audioInput)
+	, _audioOutputId(audioOutput)
+	, _videoInputId(videoInput) {
+	}
+
+	rpl::producer<QString> audioInputId() override {
+		return _audioInputId.value();
+	}
+	rpl::producer<QString> audioOutputId() override {
+		return _audioOutputId.value();
+	}
+	rpl::producer<QString> videoInputId() override {
+		return _videoInputId.value();
+	}
+	void switchToAudioInput(QString id) override {
+		_audioInputId = id;
+	}
+	void switchToAudioOutput(QString id) override {
+		_audioOutputId = id;
+	}
+	void switchToVideoInput(QString id) override {
+		_videoInputId = id;
+	}
+
+private:
+	rpl::variable<QString> _audioInputId;
+	rpl::variable<QString> _audioOutputId;
+	rpl::variable<QString> _videoInputId;
+
+};
+
+} // namespace
+
+std::vector<VideoInput> GetVideoInputList() {
+	return {};
+}
+
+std::vector<AudioInput> GetAudioInputList(Backend backend) {
+	return {};
+}
+
+std::vector<AudioOutput> GetAudioOutputList(Backend backend) {
+	return {};
+}
+
+std::unique_ptr<MediaDevices> CreateMediaDevices(
+		QString audioInput,
+		QString audioOutput,
+		QString videoInput) {
+	return std::make_unique<MediaDevicesDummy>(
+		audioInput,
+		audioOutput,
+		videoInput);
+}
+
+} // namespace Webrtc
